# Exemplo documental, sem credenciais reais. Gere .env com python scripts/setup.py.
ENVIRONMENT=development
PUBLIC_ORIGIN=http://localhost:8080
APP_BIND=127.0.0.1
APP_PORT=8080
POSTGRES_DB=ctf
POSTGRES_USER=ctf
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://ctf:REPLACE@db:5432/ctf
SECRET_KEY=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080
SESSION_TTL_HOURS=24
REGISTRATION_ENABLED=true
REDIS_PASSWORD=
REDIS_URL=redis://:REPLACE@redis:6379/0
RATE_LIMIT_BACKEND=redis
QUEUE_ENABLED=true
QUEUE_EAGER=false
QUEUE_NAME=ctf-studio
MAX_UPLOAD_BYTES=20971520
MAX_DOCUMENT_BYTES=2097152
MAX_EXPORT_BYTES=67108864
ALLOW_ARCHIVES=false
UPLOAD_DIR=/data/uploads
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=ctf-evidences
S3_REGION=us-east-1
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SIGNED_URL_SECONDS=60
AI_ENABLED=false
AI_EXTERNAL_ENABLED=false
AI_EXTERNAL_URL=
AI_EXTERNAL_TOKEN=
AI_EXTERNAL_MODEL=
AI_TIMEOUT_SECONDS=120
AI_MAX_JOBS_PER_HOUR=10
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
KALI_ENABLED=false
KALI_MCP_URL=http://kali-mcp:8080/mcp
KALI_MCP_TOKEN=
KALI_TIMEOUT_SECONDS=30
KALI_ALLOWED_TOOLS=system_info,artifact_hash,artifact_file,artifact_strings,artifact_json_summary
KALI_MAX_JOBS_PER_MINUTE=5
METRICS_ENABLED=true
# Vazio em rede Compose privada; nginx bloqueia acesso público às métricas.
METRICS_TOKEN=
LOG_LEVEL=INFO
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3001
BACKUP_UID=10001
BACKUP_GID=10001
BACKUP_RETENTION_DAYS=30
RPO_TARGET_HOURS=24
RTO_TARGET_HOURS=4
