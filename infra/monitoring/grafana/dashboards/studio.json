{
  "uid": "ctf-studio", "title": "CTF Writeup Studio", "schemaVersion": 40, "version": 1,
  "tags": ["ctf", "api"], "timezone": "browser", "refresh": "30s", "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id":1,"title":"Disponibilidade API","type":"stat","gridPos":{"x":0,"y":0,"w":8,"h":4},"datasource":{"type":"prometheus","uid":"ctf-prometheus"},"targets":[{"expr":"up{job=\"ctf-api\"}","refId":"A"}],"fieldConfig":{"defaults":{"min":0,"max":1,"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":1}]}},"overrides":[]}},
    {"id":2,"title":"Disponibilidade PostgreSQL","type":"stat","gridPos":{"x":8,"y":0,"w":8,"h":4},"datasource":{"type":"prometheus","uid":"ctf-prometheus"},"targets":[{"expr":"pg_up","refId":"A"}]},
    {"id":3,"title":"Disponibilidade Redis","type":"stat","gridPos":{"x":16,"y":0,"w":8,"h":4},"datasource":{"type":"prometheus","uid":"ctf-prometheus"},"targets":[{"expr":"redis_up","refId":"A"}]},
    {"id":4,"title":"Requisições por segundo","type":"timeseries","gridPos":{"x":0,"y":4,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"ctf-prometheus"},"targets":[{"expr":"sum by(status) (rate(ctf_api_requests_total[5m]))","legendFormat":"HTTP {{status}}","refId":"A"}]},
    {"id":5,"title":"Latência p95 por rota (s)","type":"timeseries","gridPos":{"x":12,"y":4,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"ctf-prometheus"},"targets":[{"expr":"histogram_quantile(0.95, sum by(le,route) (rate(ctf_api_request_seconds_bucket[5m])))","legendFormat":"{{route}}","refId":"A"}]},
    {"id":6,"title":"Conexões PostgreSQL","type":"timeseries","gridPos":{"x":0,"y":12,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"ctf-prometheus"},"targets":[{"expr":"sum(pg_stat_database_numbackends)","refId":"A"}]},
    {"id":7,"title":"Memória Redis (bytes)","type":"timeseries","gridPos":{"x":12,"y":12,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"ctf-prometheus"},"targets":[{"expr":"redis_memory_used_bytes","refId":"A"}]}
  ]
}
